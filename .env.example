# Vision provider: gemini | openai | anthropic
VISION_PROVIDER=anthropic

# Vision model — omit to use the default for your provider:
#   anthropic → claude-haiku-4-5
#   openai    → gpt-5.4-mini
#   gemini    → gemini-2.5-flash
VISION_MODEL=claude-haiku-4-5

# API keys — only the key for your chosen provider is required
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# USDA FoodData Central — get a free key at https://fdc.nal.usda.gov/api-guide.html
# Rate limit: 1000 req/hour/IP. Omit to use DEMO_KEY (very limited).
USDA_API_KEY=

# PostgreSQL connection strings. The app/migrations pick one based on NODE_ENV:
#   NODE_ENV=production -> PROD_DB_URL   (hosted DB, e.g. Aiven; requires SSL)
#   otherwise           -> DEV_DB_URL    (local Postgres)
DEV_DB_URL=postgresql://user:password@localhost:5432/macrosnap
PROD_DB_URL=

# Allowed CORS origins for the frontend (comma-separated). localhost is always
# allowed for local dev, so this is only needed for deployed frontends.
# Example: CORS_ORIGINS=https://your-frontend.onrender.com,https://www.your-frontend.com
CORS_ORIGINS=

# RSA key pair for signing/verifying JWTs (RS256)
# Generate the keys first with: npm run generate-keys
# Make sure you put the keys/ directory in .gitignore
PRIVATE_KEY_PATH=keys/private.pem
PUBLIC_KEY_PATH=keys/public.pem

# Google OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match a redirect URI registered on the OAuth client in Google Cloud.
# Defaults to the localhost dev URL if unset.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Frontend base URL — where the backend redirects after Google login
# (the SPA reads the token from the URL fragment at /auth/callback).
FRONTEND_URL=http://localhost:5173

PORT=3000
